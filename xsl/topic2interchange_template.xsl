<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated into topic2interchange.xsl at plug-in install. Logic lives in topic2interchangeImpl.xsl. -->
<xsl:stylesheet version="3.0"
                xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
                xmlns:dita="http://dita-ot.sourceforge.net"
                exclude-result-prefixes="dita">

  <xsl:import href="topic2interchangeImpl.xsl"/>
  <dita:extension id="dita.xsl.interchange.topic" behavior="org.dita.dost.platform.ImportXSLAction"/>

  <xsl:output method="xhtml" html-version="5.0" encoding="UTF-8"
              omit-xml-declaration="yes" indent="no" include-content-type="no"
              doctype-system="" doctype-public=""/>

</xsl:stylesheet>
