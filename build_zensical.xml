<?xml version="1.0" encoding="UTF-8"?>
<project name="com.redhat.zensical" xmlns:if="ant:if" xmlns:unless="ant:unless">

  <!--
    Pipeline, in ${output.dir}:

      1. interchange   DITA-OT writes interchange/ (see INTERCHANGE.md). No Zensical knowledge.
      2. sources       The Python adapter (python/dita_zensical) turns the interchange into
                       docs/ and zensical.toml, the form Zensical accepts today.
      3. site          zensical build writes site/.

    zensical.stage picks the last step to run. A future Zensical module would consume
    step 1 directly and replace step 2.
  -->
  <target name="dita2zensical"
          depends="zensical.init,
                   html5.init,
                   build-init,
                   preprocess2,
                   html5.topic,
                   zensical.site-json,
                   zensical.python.find,
                   zensical.write,
                   zensical.build"/>

  <target name="zensical.init">
    <property name="zensical.plugin.dir" location="${dita.plugin.com.redhat.zensical.dir}"/>
    <property name="zensical.root.dir" location="${output.dir}"/>
    <property name="zensical.interchange.dir" location="${zensical.root.dir}/interchange"/>
    <property name="zensical.docs.dir" location="${zensical.root.dir}/docs"/>

    <!-- dita.output.dir is set with a <condition> in build-init, so presetting it here wins -->
    <property name="dita.output.dir" location="${zensical.interchange.dir}/content"/>

    <property name="out.ext" value=".html"/>
    <property name="args.xsl" location="${zensical.plugin.dir}/xsl/topic2interchange.xsl"/>

    <!-- The site generator owns navigation: skip the HTML5 cover/TOC page, its CSS and family links -->
    <property name="html5.toc.generate" value="false"/>
    <property name="args.rellinks" value="nofamily"/>
    <property name="args.copycss" value="no"/>

    <property name="zensical.stage" value="site"/>
    <property name="zensical.home" value="generated"/>
    <property name="zensical.admonitions" value="yes"/>
    <property name="zensical.theme.tables" value="yes"/>
    <property name="zensical.highlight" value="yes"/>
    <property name="zensical.code.default-lang" value="text"/>
    <property name="zensical.source.links" value="none"/>
    <property name="zensical.source.action" value="edit"/>
    <property name="zensical.strict" value="no"/>
    <property name="zensical.executable" value="zensical"/>
    <fail message="zensical.stage must be interchange, sources or site, not '${zensical.stage}'">
      <condition><not><or>
        <equals arg1="${zensical.stage}" arg2="interchange"/>
        <equals arg1="${zensical.stage}" arg2="sources"/>
        <equals arg1="${zensical.stage}" arg2="site"/>
      </or></not></condition>
    </fail>
    <condition property="zensical.write.yes"><not><equals arg1="${zensical.stage}" arg2="interchange"/></not></condition>
    <condition property="zensical.run.yes"><equals arg1="${zensical.stage}" arg2="site"/></condition>
    <condition property="zensical.strict.yes"><equals arg1="${zensical.strict}" arg2="yes"/></condition>

    <!-- Remove output from an earlier run, but only from folders this plug-in created -->
    <zensical.reset-dir dir="${zensical.interchange.dir}"/>
    <zensical.reset-dir dir="${zensical.docs.dir}" if:set="zensical.write.yes"/>
  </target>

  <!-- Deletes a folder carrying our marker; refuses a folder created by something else -->
  <macrodef name="zensical.reset-dir">
    <attribute name="dir"/>
    <sequential>
      <local name="zensical.owned"/>
      <available file="@{dir}/.dita-zensical" property="zensical.owned"/>
      <delete dir="@{dir}" if:set="zensical.owned"/>
      <fail message="@{dir} exists and was not created by the zensical transtype. Use an empty output folder.">
        <condition><and>
          <available file="@{dir}" type="dir"/>
          <not><isset property="zensical.owned"/></not>
        </and></condition>
      </fail>
      <mkdir dir="@{dir}"/>
      <echo file="@{dir}/.dita-zensical" message="Generated by com.redhat.zensical; this folder is deleted on the next build."/>
    </sequential>
  </macrodef>

  <!-- ============ Step 1: interchange (topics are written by html5.topic) ============ -->

  <target name="zensical.site-json" description="Write interchange/site.json from the map">
    <!-- Folder of the map relative to content/, so nav paths line up with the written pages -->
    <pathconvert property="zensical.map.dir" dirsep="/">
      <path location="${_dita.map.output.dir}"/>
      <map from="${dita.output.dir}" to=""/>
    </pathconvert>
    <property name="zensical.map.dir" value=""/>
    <pipeline message="Write interchange site.json" taskname="xslt">
      <xslt destdir="${zensical.interchange.dir}" style="${zensical.plugin.dir}/xsl/map2interchange.xsl">
        <ditafileset input="true" format="ditamap"/>
        <param name="MAP_DIR" expression="${zensical.map.dir}"/>
        <param name="OUTEXT" expression="${out.ext}"/>
        <mapper type="merge" to="site.json"/>
        <xmlcatalog refid="dita.catalog"/>
      </xslt>
    </pipeline>
  </target>

  <!-- ============ Step 2: Zensical sources ============ -->

  <target name="zensical.write" if="zensical.write.yes" depends="zensical.python.find"
          description="Write docs/ and zensical.toml from the interchange">
    <!-- Ant resolves relative file locations from DITA-OT's basedir, so use user.dir explicitly. -->
    <condition property="zensical.config.resolved" value="${zensical.config}">
      <matches string="${zensical.config}" pattern="^(/|[A-Za-z]:[/\\]|\\\\).*$"/>
    </condition>
    <property name="zensical.config.resolved"
              value="${user.dir}${file.separator}${zensical.config}" if:set="zensical.config"/>
    <fail message="zensical.config file not found: ${zensical.config} (resolved to ${zensical.config.resolved})" if:set="zensical.config">
      <condition><not><available file="${zensical.config.resolved}" type="file"/></not></condition>
    </fail>
    <exec executable="${zensical.python.exe}" failonerror="false" taskname="zensical-write"
          errorproperty="zensical.write.messages" resultproperty="zensical.write.rc">
      <arg file="${zensical.plugin.dir}/python/write_site.py"/>
      <arg value="--interchange"/>      <arg file="${zensical.interchange.dir}"/>
      <arg value="--docs"/>             <arg file="${zensical.docs.dir}"/>
      <arg value="--config"/>           <arg file="${zensical.root.dir}/zensical.toml"/>
      <arg value="--user-config" if:set="zensical.config"/>      <arg file="${zensical.config.resolved}" if:set="zensical.config"/>
      <arg value="--site-name" if:set="zensical.site.name"/>        <arg value="${zensical.site.name}" if:set="zensical.site.name"/>
      <arg value="--site-url" if:set="zensical.site.url"/>         <arg value="${zensical.site.url}" if:set="zensical.site.url"/>
      <arg value="--site-description" if:set="zensical.site.description"/> <arg value="${zensical.site.description}" if:set="zensical.site.description"/>
      <arg value="--repo-url" if:set="zensical.repo.url"/>         <arg value="${zensical.repo.url}" if:set="zensical.repo.url"/>
      <arg value="--home"/>             <arg value="${zensical.home}"/>
      <arg value="--admonitions"/>      <arg value="${zensical.admonitions}"/>
      <arg value="--theme-tables"/>     <arg value="${zensical.theme.tables}"/>
      <arg value="--highlight"/>        <arg value="${zensical.highlight}"/>
      <arg value="--default-lang"/>     <arg value="${zensical.code.default-lang}"/>
      <arg value="--css"/>              <arg file="${zensical.plugin.dir}/resources/dita.css"/>
      <!-- Per-topic links to the DITA source: git repository or AEM Guides DAM -->
      <arg value="--source-links"/>     <arg value="${zensical.source.links}"/>
      <arg value="--source-action"/>    <arg value="${zensical.source.action}"/>
      <arg value="--source-root" if:set="zensical.source.root"/>                 <arg file="${zensical.source.root}" if:set="zensical.source.root"/>
      <arg value="--source-url-template" if:set="zensical.source.url-template"/> <arg value="${zensical.source.url-template}" if:set="zensical.source.url-template"/>
      <arg value="--source-view-url-template" if:set="zensical.source.view-url-template"/> <arg value="${zensical.source.view-url-template}" if:set="zensical.source.view-url-template"/>
      <arg value="--git-url" if:set="zensical.git.url"/>                         <arg value="${zensical.git.url}" if:set="zensical.git.url"/>
      <arg value="--git-branch" if:set="zensical.git.branch"/>                   <arg value="${zensical.git.branch}" if:set="zensical.git.branch"/>
      <arg value="--git-host" if:set="zensical.git.host"/>                       <arg value="${zensical.git.host}" if:set="zensical.git.host"/>
      <arg value="--dam-url" if:set="zensical.aem.dam-url"/>                     <arg value="${zensical.aem.dam-url}" if:set="zensical.aem.dam-url"/>
      <arg value="--dam-view-url" if:set="zensical.aem.view-url"/>               <arg value="${zensical.aem.view-url}" if:set="zensical.aem.view-url"/>
      <arg value="--source-path-map" if:set="zensical.source.path-map"/>         <arg file="${zensical.source.path-map}" if:set="zensical.source.path-map"/>
      <arg value="--overrides"/>        <arg file="${zensical.plugin.dir}/resources/overrides"/>
    </exec>
    <!-- DITA-OT's default logger hides exec stderr; surface the adapter's warnings -->
    <condition property="zensical.write.has-messages">
      <length string="${zensical.write.messages}" when="greater" length="0"/>
    </condition>
    <echo taskname="zensical" level="warning" message="${zensical.write.messages}"
          if:set="zensical.write.has-messages"/>
    <fail message="Writing the Zensical sources failed (exit ${zensical.write.rc}). See the messages above.">
      <condition><not><equals arg1="${zensical.write.rc}" arg2="0"/></not></condition>
    </fail>
  </target>

  <!--
    Find the Python that Zensical runs on; the adapter uses its Python-Markdown,
    pymdownx and Pygments. Tried in order, first that can import them wins:
      1. zensical.python, if you set it (no fallback then)
      2. a python next to the zensical command (virtualenv, pipx, uv tool, Windows Scripts\)
      3. the interpreter named in the zensical script's shebang
      4. python3, python, py on PATH
  -->
  <target name="zensical.python.find" if="zensical.write.yes">
    <zensical.try-python candidate="${zensical.python}" if:set="zensical.python"/>
    <fail message="zensical.python=${zensical.python} cannot import markdown and pymdownx. Point it at the Python Zensical is installed in."
          if:set="zensical.python" unless:set="zensical.python.exe"/>

    <!-- Locate the zensical command: an explicit path, or the first match on PATH -->
    <property environment="zensical.env"/>
    <condition property="zensical.search.path" value="${zensical.env.PATH}" else="${zensical.env.Path}">
      <isset property="zensical.env.PATH"/>
    </condition>
    <pathconvert property="zensical.search.dirs" pathsep=",">
      <path path="${zensical.search.path}"/>
    </pathconvert>
    <condition property="zensical.command.path" value="${zensical.executable}">
      <available file="${zensical.executable}" type="file"/>
    </condition>
    <pathconvert property="zensical.command.path" setonempty="false" unless:set="zensical.command.path">
      <first>
        <multirootfileset basedirs="${zensical.search.dirs}" type="file" erroronmissingdir="false"
                          includes="${zensical.executable},${zensical.executable}.exe,${zensical.executable}.cmd"/>
      </first>
    </pathconvert>

    <sequential if:set="zensical.command.path">
      <dirname property="zensical.command.dir" file="${zensical.command.path}"/>
      <zensical.try-python-file candidate="${zensical.command.dir}/python"/>
      <zensical.try-python-file candidate="${zensical.command.dir}/python3"/>
      <zensical.try-python-file candidate="${zensical.command.dir}/python.exe"/>
      <loadfile srcfile="${zensical.command.path}" property="zensical.shebang" failonerror="false" quiet="true">
        <filterchain>
          <headfilter lines="3"/>
          <tokenfilter>
            <containsregex pattern="^(?:#!\s*|'''exec'\s+'?)([^'\s]*python[^'\s]*).*$" replace="\1"/>
          </tokenfilter>
          <headfilter lines="1"/>
          <striplinebreaks/>
        </filterchain>
      </loadfile>
      <zensical.try-python-file candidate="${zensical.shebang}" if:set="zensical.shebang"/>
    </sequential>

    <zensical.try-python candidate="python3"/>
    <zensical.try-python candidate="python"/>
    <zensical.try-python candidate="py"/>

    <fail unless="zensical.python.exe">No Python with Zensical's Markdown libraries (markdown, pymdownx) was found.
Set -Dzensical.python=/path/to/the/python/Zensical/uses, or -Dzensical.stage=interchange to stop before the Zensical step.</fail>
    <echo taskname="zensical" level="info">Using Python ${zensical.python.exe}</echo>
  </target>

  <!-- Sets zensical.python.exe to the candidate if it can import the adapter's libraries; skipped once set -->
  <macrodef name="zensical.try-python">
    <attribute name="candidate"/>
    <sequential>
      <local name="zensical.try.rc"/>
      <local name="zensical.try.out"/>
      <exec executable="@{candidate}" unless:set="zensical.python.exe"
            failonerror="false" failifexecutionfails="false"
            resultproperty="zensical.try.rc" outputproperty="zensical.try.out" errorproperty="zensical.try.out">
        <arg value="-c"/>
        <arg value="import markdown, pymdownx.highlight, pymdownx.superfences, pygments"/>
      </exec>
      <condition property="zensical.python.exe" value="@{candidate}">
        <equals arg1="${zensical.try.rc}" arg2="0"/>
      </condition>
    </sequential>
  </macrodef>

  <!-- Same, for an interpreter path; skips paths that do not exist so the log stays clean -->
  <macrodef name="zensical.try-python-file">
    <attribute name="candidate"/>
    <sequential>
      <local name="zensical.try.exists"/>
      <available file="@{candidate}" type="file" property="zensical.try.exists"/>
      <zensical.try-python candidate="@{candidate}" if:set="zensical.try.exists"/>
    </sequential>
  </macrodef>

  <!-- ============ Step 3: site ============ -->

  <target name="zensical.build" if="zensical.run.yes" description="Run zensical build">
    <exec executable="${zensical.executable}" dir="${zensical.root.dir}"
          searchpath="true" failonerror="true" taskname="zensical">
      <arg value="build"/>
      <arg value="--config-file"/>
      <arg file="${zensical.root.dir}/zensical.toml"/>
      <arg value="--strict" if:set="zensical.strict.yes"/>
    </exec>
  </target>

</project>
